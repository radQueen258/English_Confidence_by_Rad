
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'radka.fnhapulo@gmail.com';
    }

    function isOwnEmail(email) {
      return isSignedIn()
        && request.auth.token.email == email;
    }

    function invitationExists(email) {
      return exists(
        /databases/$(database)/documents/invitations/$(email)
      );
    }

    function invitationStatus(email) {
      return get(
        /databases/$(database)/documents/invitations/$(email)
      ).data.status;
    }

    function canReadOwnProfile(email) {
      return isOwnEmail(email)
        && invitationExists(email)
        && invitationStatus(email) != 'revoked';
    }

    function canAccessLessons(email) {
      return isOwnEmail(email)
        && invitationExists(email)
        && invitationStatus(email) == 'active';
    }


    // ==========================================
    // PREVIOUS ACTIVITY COMPLETION
    // ==========================================

    function hasCompletion(email, monthId, previousLessonId) {
      return exists(
        /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(previousLessonId)/completions/status
      );
    }


    function ownLessonCompleted(email, monthId, lessonId) {
        return exists(
           /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)/completions/status
        );
    }


    function previousActivityCompleted(email, monthId, lessonId) {

      return lessonId == 'lesson-1'

        || (
          lessonId == 'lesson-2'
          && hasCompletion(email, monthId, 'lesson-1')
        )

        || (
          lessonId == 'lesson-3'
          && hasCompletion(email, monthId, 'lesson-2')
        )

        || (
          lessonId == 'lesson-4'
          && hasCompletion(email, monthId, 'lesson-3')
        )

        || (
          lessonId == 'lesson-5'
          && hasCompletion(email, monthId, 'lesson-4')
        )

        || (
          lessonId == 'lesson-6'
          && hasCompletion(email, monthId, 'lesson-5')
        )

        || (
          lessonId == 'lesson-7'
          && hasCompletion(email, monthId, 'lesson-6')
        )

        || (
          lessonId == 'lesson-8'
          && hasCompletion(email, monthId, 'lesson-7')
        )

        || (
          lessonId == 'lesson-9'
          && hasCompletion(email, monthId, 'lesson-8')
        )

        || (
          lessonId == 'lesson-10'
          && hasCompletion(email, monthId, 'lesson-9')
        )

        || (
          lessonId == 'lesson-11'
          && hasCompletion(email, monthId, 'lesson-10')
        )

        || (
          lessonId == 'lesson-12'
          && hasCompletion(email, monthId, 'lesson-11')
        );
    }


    // ==========================================
    // INVITATIONS
    // ==========================================

    match /invitations/{email} {

      allow get: if isAdmin() || isOwnEmail(email);

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ==========================================
    // STUDENT PROFILES
    // ==========================================

    match /students/{email} {

      allow get: if isAdmin()
        || canReadOwnProfile(email);

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();


      // ========================================
      // MONTHS
      // ========================================

      match /months/{monthId} {

        allow get, list: if isAdmin()
          || canReadOwnProfile(email);

        allow create, update, delete: if isAdmin();


        // ======================================
        // LESSONS
        // ======================================

        match /lessons/{lessonId} {

          // Students can retrieve individual lessons
          // only after the previous activity is done.


allow get: if isAdmin()

  // Active students can access published lessons
  // once the previous activity has been completed.
  || (

    canAccessLessons(email)

    && resource.data.published == true

    && previousActivityCompleted(
      email,
      monthId,
      lessonId
    )

  )

  // Active or paused students can revisit
  // lessons they have already completed.
  || (

    canReadOwnProfile(email)

    && ownLessonCompleted(
      email,
      monthId,
      lessonId
    )

  );


          // Students use individual getDoc requests,
          // not collection queries, for lesson access.
          allow list: if isAdmin();

          // Teachers control all lesson content.
          allow create, update, delete: if isAdmin();


          // ====================================
          // COMPLETION RECORDS
          // ====================================

          match /completions/{completionId} {

            allow get, list: if isAdmin()
              || canReadOwnProfile(email);


            // Admin can manage every completion.
            // Students can ONLY create their own
            // self-paced podcast completion.
            allow create: if isAdmin()

              || (

                canAccessLessons(email)

                && completionId == 'status'

                && get(
                  /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)
                ).data.type == 'podcast'

                && get(
                  /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)
                ).data.published == true

                && previousActivityCompleted(
                  email,
                  monthId,
                  lessonId
                )

                && request.resource.data.keys().hasOnly([
                  'completed',
                  'completedAt',
                  'completedByEmail'
                ])

                && request.resource.data.keys().hasAll([
                  'completed',
                  'completedAt',
                  'completedByEmail'
                ])

                && request.resource.data.completed == true

                && request.resource.data.completedByEmail
                  == request.auth.token.email

                && request.resource.data.completedAt == request.time

              );


            // Only the teacher can change or remove
            // completion records.
            allow update, delete: if isAdmin();

          }

        }

      }

    }


    // ==========================================
    // EVERYTHING ELSE DENIED
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}

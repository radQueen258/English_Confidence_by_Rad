
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION
    // ==========================================

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower()
          == 'radka.fnhapulo@gmail.com';
    }

    function isOwnEmail(email) {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower()
          == email.lower();
    }

    function invitationExists(email) {
      return exists(
        /databases/$(database)/documents/invitations/$(email)
      );
    }

    function invitationStatus(email) {
      return get(
        /databases/$(database)/documents/invitations/$(email)
      ).data.status;
    }

    function canReadOwnProfile(email) {
      return isOwnEmail(email)
        && invitationExists(email)
        && invitationStatus(email) != 'revoked';
    }

    function canAccessLessons(email) {
      return isOwnEmail(email)
        && invitationExists(email)
        && invitationStatus(email) == 'active';
    }


    // ==========================================
    // COMPLETION HELPERS
    // ==========================================

    function hasCompletion(email, monthId, lessonId) {
      return exists(
        /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)/completions/status
      );
    }

    function ownLessonCompleted(email, monthId, lessonId) {
      return exists(
        /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)/completions/status
      );
    }

    function finalLessonCompleted(email, monthId) {
      let path =
        /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/lesson-12/completions/status;

      return exists(path)
        && get(path).data.completed == true;
    }

    function previousActivityCompleted(email, monthId, lessonId) {

      return lessonId == 'lesson-1'

        || (
          lessonId == 'lesson-2'
          && hasCompletion(email, monthId, 'lesson-1')
        )

        || (
          lessonId == 'lesson-3'
          && hasCompletion(email, monthId, 'lesson-2')
        )

        || (
          lessonId == 'lesson-4'
          && hasCompletion(email, monthId, 'lesson-3')
        )

        || (
          lessonId == 'lesson-5'
          && hasCompletion(email, monthId, 'lesson-4')
        )

        || (
          lessonId == 'lesson-6'
          && hasCompletion(email, monthId, 'lesson-5')
        )

        || (
          lessonId == 'lesson-7'
          && hasCompletion(email, monthId, 'lesson-6')
        )

        || (
          lessonId == 'lesson-8'
          && hasCompletion(email, monthId, 'lesson-7')
        )

        || (
          lessonId == 'lesson-9'
          && hasCompletion(email, monthId, 'lesson-8')
        )

        || (
          lessonId == 'lesson-10'
          && hasCompletion(email, monthId, 'lesson-9')
        )

        || (
          lessonId == 'lesson-11'
          && hasCompletion(email, monthId, 'lesson-10')
        )

        || (
          lessonId == 'lesson-12'
          && hasCompletion(email, monthId, 'lesson-11')
        );
    }


    // ==========================================
    // INVITATIONS
    // ==========================================

    match /invitations/{email} {

      allow get: if isAdmin() || isOwnEmail(email);

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // ==========================================
    // STUDENT PROFILES
    // ==========================================

    match /students/{email} {

      allow get: if isAdmin()
        || canReadOwnProfile(email);

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();


      // ========================================
      // MONTHLY RECORDS
      // ========================================

      match /months/{monthId} {

        allow get, list: if isAdmin()
          || canReadOwnProfile(email);

        allow create, update, delete: if isAdmin();


        // ======================================
        // LESSONS
        // ======================================

        match /lessons/{lessonId} {

          allow get: if isAdmin()

            || (
              canAccessLessons(email)
              && resource.data.published == true
              && previousActivityCompleted(
                email,
                monthId,
                lessonId
              )
            )

            || (
              canReadOwnProfile(email)
              && ownLessonCompleted(
                email,
                monthId,
                lessonId
              )
            );

          allow list: if isAdmin();

          allow create, update, delete: if isAdmin();


          // ====================================
          // COMPLETION RECORDS
          // ====================================

          match /completions/{completionId} {

            allow get, list: if isAdmin()
              || canReadOwnProfile(email);


            allow create: if isAdmin()

              || (

                canAccessLessons(email)

                && completionId == 'status'

                && get(
                  /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)
                ).data.type == 'podcast'

                && get(
                  /databases/$(database)/documents/students/$(email)/months/$(monthId)/lessons/$(lessonId)
                ).data.published == true

                && previousActivityCompleted(
                  email,
                  monthId,
                  lessonId
                )

                && request.resource.data.keys().hasOnly([
                  'completed',
                  'completedAt',
                  'completedByEmail'
                ])

                && request.resource.data.keys().hasAll([
                  'completed',
                  'completedAt',
                  'completedByEmail'
                ])

                && request.resource.data.completed == true

                && request.resource.data.completedByEmail
                  == request.auth.token.email

                && request.resource.data.completedAt == request.time

              );

            allow update, delete: if isAdmin();

          }

        } // END LESSONS


        // ======================================
        // MONTHLY FEEDBACK
        // ======================================

        match /feedback/{feedbackId} {

          allow get: if isAdmin()
            || canReadOwnProfile(email);

          allow list: if isAdmin();

          allow create: if isOwnEmail(email)

            && canReadOwnProfile(email)

            && feedbackId == 'current'

            && finalLessonCompleted(email, monthId)

            && request.resource.data.keys().hasAll([
              'email',
              'studentName',
              'monthNumber',
              'monthKey',
              'liked',
              'improve',
              'submittedAt'
            ])

            && request.resource.data.keys().hasOnly([
              'email',
              'studentName',
              'monthNumber',
              'monthKey',
              'liked',
              'improve',
              'submittedAt'
            ])

            && request.resource.data.email == email

            && request.resource.data.monthKey == monthId

            && request.resource.data.monthNumber is int

            && request.resource.data.liked is string

            && request.resource.data.improve is string

            && request.resource.data.liked.size() > 0

            && request.resource.data.improve.size() > 0

            && request.resource.data.liked.size() <= 3000

            && request.resource.data.improve.size() <= 3000

            && request.resource.data.submittedAt == request.time;

          allow update, delete: if isAdmin();

        }


        // ======================================
        // MONTHLY PAYMENT / RENEWAL
        // ======================================

        match /renewals/{renewalId} {

          allow get: if isAdmin()
            || canReadOwnProfile(email);

          allow list: if isAdmin();


          // Validate screenshot and payment data.
          function validRenewalFields(data) {

            return data.email == email

              && data.studentName is string

              && data.monthNumber is int

              && data.monthKey == monthId

              && data.nextMonthNumber == data.monthNumber + 1

              && data.paymentMethod in [
                'emola',
                'mpesa',
                'bim'
              ]

              && data.paymentReference is string

              && data.paymentReference.size() <= 120

              && data.screenshotMimeType in [
                'image/webp',
                'image/jpeg',
                'image/png'
              ]

              && data.screenshotBytes is int

              && data.screenshotBytes > 0

              && data.screenshotBytes <= 409600

              && data.screenshotDataUrl is string

              && data.screenshotDataUrl.size() < 600000

              && data.screenshotDataUrl.matches(
                '^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'
              );

          }


          allow create: if isOwnEmail(email)

            && canReadOwnProfile(email)

            && renewalId == 'current'

            && finalLessonCompleted(email, monthId)

            && request.resource.data.keys().hasAll([
              'email',
              'studentName',
              'monthNumber',
              'monthKey',
              'nextMonthNumber',
              'paymentMethod',
              'paymentReference',
              'screenshotDataUrl',
              'screenshotMimeType',
              'screenshotBytes',
              'status',
              'submittedAt'
            ])

            && request.resource.data.keys().hasOnly([
              'email',
              'studentName',
              'monthNumber',
              'monthKey',
              'nextMonthNumber',
              'paymentMethod',
              'paymentReference',
              'screenshotDataUrl',
              'screenshotMimeType',
              'screenshotBytes',
              'status',
              'submittedAt'
            ])

            && validRenewalFields(request.resource.data)

            && request.resource.data.status == 'pending'

            && request.resource.data.submittedAt == request.time;


          // Student can resubmit only after rejection.
          allow update: if isAdmin()

            || (

              isOwnEmail(email)

              && canReadOwnProfile(email)

              && renewalId == 'current'

              && resource.data.status == 'rejected'

              && request.resource.data.status == 'pending'

              && request.resource.data.email == resource.data.email

              && request.resource.data.monthKey == resource.data.monthKey

              && request.resource.data.monthNumber == resource.data.monthNumber

              && request.resource.data.nextMonthNumber == resource.data.nextMonthNumber

              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'studentName',
                'paymentMethod',
                'paymentReference',
                'screenshotDataUrl',
                'screenshotMimeType',
                'screenshotBytes',
                'status',
                'submittedAt'
              ])

              && validRenewalFields(request.resource.data)

              && request.resource.data.submittedAt == request.time

            );

          allow delete: if isAdmin();

        }

      } // END MONTHS

    } // END STUDENTS


    // ==========================================
    // PAYMENT METHOD SETTINGS
    // ==========================================

    match /settings/{settingId} {

      allow get: if isAdmin()

        || (
          settingId == 'paymentMethods'
          && isSignedIn()
          && request.auth.token.email is string
          && invitationExists(
            request.auth.token.email.lower()
          )
          && invitationStatus(
            request.auth.token.email.lower()
          ) != 'revoked'
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();

    }


    // ==========================================
    // COLLECTION GROUP ACCESS
    // ADMIN ONLY
    // ==========================================

    match /{path=**}/feedback/{feedbackId} {

      allow list: if isAdmin();

    }

    match /{path=**}/renewals/{renewalId} {

      allow list: if isAdmin();

    }


    // ==========================================
    // DEFAULT DENY
    // ==========================================

    match /{document=**} {

      allow read, write: if false;

    }

  }
}
